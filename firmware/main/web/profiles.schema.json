{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isno-Open/OpenProfalux/firmware/main/web/profiles.schema.json",
  "title": "Catalog",
  "description": "Le catalogue d'OpenProfalux (profiles.json) : protocoles, types et profils. Modele : docs/PROFILES.md. Ce schema dit la FORME ; les regles qui relient les parties (un profil designe un protocole qui existe, une frequence dans la bande d'une carte...) sont dans ui/scripts/gen-catalog.ts. Une cle qui commence par '_' est une note.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "type": "string"
    }
  },
  "required": [
    "devices_max",
    "name_max",
    "roles",
    "traits",
    "protocols",
    "types",
    "profiles"
  ],
  "properties": {
    "devices_max": {
      "description": "Nombre maximal d'appareils d'un boitier (COVER_DEVICES_MAX).",
      "type": "integer",
      "minimum": 1
    },
    "name_max": {
      "description": "Plus long nom d'un appareil (COVER_NAME_MAX).",
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "required": [
        "central",
        "zone"
      ],
      "properties": {
        "central": {
          "$ref": "#/$defs/Role"
        },
        "zone": {
          "$ref": "#/$defs/Role"
        }
      }
    },
    "traits": {
      "description": "Traits de detection, par chemin dans le profil resolu.",
      "type": "object",
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/Trait"
      }
    },
    "protocols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/Protocol"
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/DeviceType"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Profile"
      }
    }
  },
  "$defs": {
    "Command": {
      "description": "Commande d'un appareil, telle qu'elle part sur le fil (corps de /api/shutter).",
      "type": "string",
      "enum": [
        "up",
        "stop",
        "down",
        "prog",
        "step"
      ]
    },
    "MoveCommand": {
      "description": "Commande qu'un type expose a Home Assistant et au cloud.",
      "type": "string",
      "enum": [
        "up",
        "stop",
        "down"
      ]
    },
    "Band": {
      "type": "string",
      "enum": [
        "433",
        "868"
      ]
    },
    "AddMethod": {
      "description": "copy : le boitier copie la telecommande d'origine. enrol : le moteur apprend le boitier comme nouvelle telecommande.",
      "type": "string",
      "enum": [
        "copy",
        "enrol"
      ]
    },
    "Encoder": {
      "description": "Encodeur du firmware (du code) qui fabrique la trame.",
      "type": "string",
      "enum": [
        "keeloq",
        "somfy-rts",
        "raw-replay"
      ]
    },
    "Role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "icon",
        "members_label",
        "members",
        "en"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "members_label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "simple",
              "central",
              "zone"
            ]
          }
        },
        "positional_only": {
          "type": "boolean"
        },
        "list_first": {
          "type": "boolean"
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "members_label"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "members_label": {
              "type": "string"
            }
          }
        },
        "icon": {
          "description": "Le NOM d'un dessin de la planche du projet (ui/src/assets/icons.svg.txt, symbole i-<nom>), le meme pour l'interface du boitier et pour le portail cloud.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "Trait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "certain : filtre la detection. Les autres valeurs ne filtrent pas.",
          "type": "string",
          "enum": [
            "certain",
            "measured"
          ]
        },
        "detected": {
          "description": "Observable sur une capture.",
          "type": "boolean"
        }
      }
    },
    "Step": {
      "description": "Une etape de la procedure d'ajout d'un protocole.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step"
      ],
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "identify",
            "instruction",
            "capture",
            "emit-enrol",
            "confirm",
            "test"
          ]
        },
        "text": {
          "description": "Texte montre a l'utilisateur.",
          "type": "string",
          "minLength": 1
        },
        "from": {
          "description": "instruction : le texte vient du bloc 'instructions' du profil, sous cette cle.",
          "type": "string",
          "enum": [
            "before",
            "gestures"
          ]
        },
        "optional": {
          "description": "instruction : sautee si le profil n'a pas ce texte.",
          "type": "boolean"
        },
        "retry": {
          "description": "L'etape peut etre recommencee.",
          "type": "boolean"
        },
        "wait_s": {
          "description": "Attente avant de pouvoir confirmer.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "encoder",
        "code",
        "buttons",
        "press",
        "procedures"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "encoder": {
          "$ref": "#/$defs/Encoder"
        },
        "code": {
          "description": "rolling : code tournant, ne se rejoue pas. fixed : la meme trame a chaque appui.",
          "type": "string",
          "enum": [
            "rolling",
            "fixed"
          ]
        },
        "buttons": {
          "description": "fixed : chaque commande a son code (commands). free : chaque bouton emet la trame capturee pour lui.",
          "type": "string",
          "enum": [
            "fixed",
            "free"
          ]
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Command"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            }
          }
        },
        "press": {
          "description": "Un appui : nombre de trames emises, et ecart entre deux trames s'il n'est pas celui de l'encodeur.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frames"
          ],
          "properties": {
            "frames": {
              "type": "integer",
              "minimum": 1
            },
            "gap_us": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "enrol": {
          "description": "Trame d'enrolement : un code de bouton emis en salves (KeeLoq), ou une commande du protocole (Somfy PROG).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "command": {
              "$ref": "#/$defs/Command"
            },
            "frames_per_burst": {
              "type": "integer",
              "minimum": 1
            },
            "bursts": {
              "type": "integer",
              "minimum": 1
            },
            "burst_gap_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "procedures": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "copy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Step"
              }
            },
            "enrol": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Step"
              }
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "LocalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Button": {
      "description": "Un bouton du pave d'un type. Son libelle est celui de sa commande, sauf s'il en declare un.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "command": {
          "$ref": "#/$defs/Command"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row",
            "col"
          ],
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cycle": {
          "description": "Bouton pas a pas : les commandes que le moteur enchaine, un appui chacune.",
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/MoveCommand"
          }
        },
        "press_gap_ms": {
          "description": "Bouton pas a pas : ecart minimal entre deux appuis.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DeviceType": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "en",
        "icon",
        "entity",
        "positional",
        "commands",
        "buttons"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "$ref": "#/$defs/LocalLabel"
        },
        "icon": {
          "description": "Le NOM d'un dessin de la planche du projet (ui/src/assets/icons.svg.txt, symbole i-<nom>), le meme pour l'interface du boitier et pour le portail cloud.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "entity": {
          "description": "L'entite Home Assistant du type.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "device_class"
          ],
          "properties": {
            "component": {
              "description": "La famille d'entites Home Assistant : du code, celles que le firmware sait annoncer (catalog.h, CATALOG_COMPONENTS).",
              "type": "string",
              "enum": [
                "cover"
              ]
            },
            "device_class": {
              "type": "string",
              "description": "Les classes d'un cover de Home Assistant, celles que le firmware connait (catalog.h, CATALOG_COVER_CLASSES) : le generateur refuse toute divergence.",
              "enum": [
                "awning",
                "blind",
                "curtain",
                "damper",
                "door",
                "garage",
                "gate",
                "shade",
                "shutter",
                "window"
              ]
            }
          }
        },
        "positional": {
          "type": "boolean"
        },
        "travel_s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "commands": {
          "description": "Ce que le type expose a Home Assistant et au cloud, avec ses libelles.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "up",
            "stop",
            "down"
          ],
          "properties": {
            "up": {
              "$ref": "#/$defs/CommandLabel"
            },
            "stop": {
              "$ref": "#/$defs/CommandLabel"
            },
            "down": {
              "$ref": "#/$defs/CommandLabel"
            }
          }
        },
        "secure": {
          "description": "Commandes qui donnent acces aux lieux : le cloud exige un code avant de les envoyer pour un tiers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoveCommand"
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Button"
          }
        },
        "legacy": {
          "description": "Mode legacy : le numero de ce type dans les fiches d'avant les profils (v0.2.16 et avant). Lu pour les migrer, jamais ecrit.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "CommandLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "en"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Radio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/Band"
        },
        "freq_khz": {
          "description": "Porteuse par defaut ; une fiche peut la surcharger (frequence calee).",
          "type": "integer",
          "minimum": 1
        },
        "modulation": {
          "type": "string",
          "enum": [
            "OOK",
            "FSK"
          ]
        },
        "rx": {
          "description": "Reglage de reception pour une capture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "datarate_baud": {
              "type": "integer",
              "minimum": 1
            },
            "bandwidth_khz": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "Tx": {
      "description": "Reglages d'emission par defaut ; une fiche peut les surcharger.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "te_us": {
          "type": "integer",
          "minimum": 1
        },
        "repeat_bit": {
          "type": "boolean"
        },
        "rmt": {
          "type": "boolean"
        },
        "frame_bits": {
          "type": "integer",
          "enum": [
            56,
            80
          ]
        }
      }
    },
    "Profile": {
      "description": "Un profil. Avec 'inherits', il ne porte que ce qui change par rapport a sa base (un niveau de profondeur pour les objets).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "inherits": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "protocol": {
          "type": "string"
        },
        "add": {
          "$ref": "#/$defs/AddMethod"
        },
        "radio": {
          "$ref": "#/$defs/Radio"
        },
        "tx": {
          "$ref": "#/$defs/Tx"
        },
        "models": {
          "description": "Modeles de telecommande que l'etape identify reconnait pour ce profil.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instructions": {
          "description": "Textes que la procedure du protocole montre (etapes instruction 'from').",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": "string",
              "minLength": 1
            },
            "gestures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "tested",
                "untested"
              ]
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
