# OpenKeeloq - default sdkconfig
# partitions.csv reclame 2.1 Mo : la valeur par defaut de 2 Mo fait echouer le build
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Compilation de production : -Os, et journal plafonne a INFO. Le firmware n'emet aucun
# ESP_LOGD/ESP_LOGV : le plafond ne retire que le detail interne d'ESP-IDF. Ensemble :
# ~-160 Ko de flash et ~-9 Ko d'IRAM (ATOM). Pour deboguer (pas-a-pas, traces plus
# precises), repasser en CONFIG_COMPILER_OPTIMIZATION_DEBUG. Un sdkconfig deja engendre
# garde ses anciens reglages : le supprimer pour reprendre ces valeurs.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Target compile flag - carte de test = M5Stack ATOM Lite (pinout docs/WIRING.md)
CONFIG_OPENPROFALUX_TARGET_M5STACK=y

# Serveur HTTP : buffer d'en-tetes de requete.
# Le defaut IDF (512 o) est trop petit pour un navigateur moderne : Chrome envoie
# User-Agent + Accept + Accept-Language + sec-ch-ua* + Sec-Fetch-* = ~600 o, et le
# serveur repond "431 Header fields are too long" (page blanche cote navigateur).
# Le cookie de session (~50 o) ne fait qu'aggraver un depassement deja present.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# WiFi
CONFIG_ESP32_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP32_WIFI_RX_BA_WIN=6

# MQTT
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Bootloader
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# Retour automatique : une mise a jour demarre en essai ; si elle redemarre avant d'etre
# validee (~60 s, voir ota.c), le bootloader repart sur la version precedente. Vit dans le
# BOOTLOADER, que l'OTA ne remplace pas : un boitier deja installe l'obtient par USB
# (firmware/README.md). +64 o de bootloader sur ESP32 (2,4 Ko restent libres).
# Surtout PAS CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK : il grave des efuses, sans retour possible.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# mbedTLS / mqtts : bundle d'autorites publiques (brokers publics) + buffers dynamiques
# pour que la poignee de main TLS tienne en RAM, y compris sur l'ESP32 simple de l'ATOM
# Lite (~36 Ko -> ~8 Ko de pic). IN_CONTENT_LEN reste au defaut de 16384 : le reduire
# casse le handshake (erreur mbedTLS 0x7200).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
