# OpenKeeloq - default sdkconfig
# partitions.csv reclame 2.1 Mo : la valeur par defaut de 2 Mo fait echouer le build
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Compilation de production : -Os, et journal plafonne a INFO. Le firmware n'emet aucun
# ESP_LOGD/ESP_LOGV : le plafond ne retire que le detail interne d'ESP-IDF. Ensemble :
# ~-160 Ko de flash et ~-9 Ko d'IRAM (ATOM). Pour deboguer (pas-a-pas, traces plus
# precises), repasser en CONFIG_COMPILER_OPTIMIZATION_DEBUG. Un sdkconfig deja engendre
# garde ses anciens reglages : le supprimer pour reprendre ces valeurs.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Target compile flag - carte de test = M5Stack ATOM Lite (pinout docs/WIRING.md)
CONFIG_OPENPROFALUX_TARGET_M5STACK=y

# Serveur HTTP : buffer d'en-tetes de requete.
# Le defaut IDF (512 o) est trop petit pour un navigateur moderne : Chrome envoie
# User-Agent + Accept + Accept-Language + sec-ch-ua* + Sec-Fetch-* = ~600 o, et le
# serveur repond "431 Header fields are too long" (page blanche cote navigateur).
# Le cookie de session (~50 o) ne fait qu'aggraver un depassement deja present.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# WiFi
CONFIG_ESP32_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP32_WIFI_RX_BA_WIN=6

# MQTT
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Bootloader
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# Retour automatique : une mise a jour demarre en essai ; si elle redemarre avant d'etre
# validee (~60 s, voir ota.c), le bootloader repart sur la version precedente. Vit dans le
# BOOTLOADER, que l'OTA ne remplace pas : un boitier deja installe l'obtient par USB
# (firmware/README.md). +64 o de bootloader sur ESP32 (2,4 Ko restent libres).
# Surtout PAS CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK : il grave des efuses, sans retour possible.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# mbedTLS / mqtts : bundle d'autorites publiques (brokers publics) + buffers dynamiques
# pour que la poignee de main TLS tienne en RAM, y compris sur l'ESP32 simple de l'ATOM
# Lite (~36 Ko -> ~8 Ko de pic). IN_CONTENT_LEN reste au defaut de 16384 : le reduire
# casse le handshake (erreur mbedTLS 0x7200).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# Enregistrements TLS SORTANTS de 2 Ko au plus (defaut 4 Ko) : ils doivent tenir dans le tampon
# d'envoi TCP borne plus bas (2 880 o). Un enregistrement de 4 Ko n'y entrait pas d'un coup ; sous
# charge Wi-Fi, l'ecriture restait bloquee 10 s (« Writing didn't complete in specified timeout »)
# et la connexion HA en mqtts se refaisait toutes les 30 a 60 s (mesure du 2026-11-14 sur l'ATOM).
# Rien a negocier : c'est ce que le boitier emet, et son plus gros message est le certificat
# client du cloud (~1 Ko). Le tampon d'emission de mbedTLS en est d'autant plus petit.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# Allocateur de mbedTLS fourni par le firmware (main/tls_pool.c) : reserve TLS prise d'un bloc
# au demarrage (TLS_POOL_BYTES) ; ce qui la depasse retombe sur le tas, et se compte.
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y

# ── Budgets reseau bornes a la RAM interne ──
# Valables pour toutes les cartes actuelles : aucune n'active la PSRAM, et le tas disponible
# au demarrage est de 186 Ko sur ESP32, 150 Ko sur ESP32-S3, 130 Ko sur ESP32-C3 (idf.py size
# et sonde au demarrage, 2026-11-14). Une carte qui activerait la PSRAM y logerait ces tampons
# (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP) et aurait son propre fragment.
# Les valeurs par defaut d'ESP-IDF laissent au pire 32 tampons Wi-Fi de reception (~54 Ko), 32
# d'emission (~51 Ko) et 5 760 o d'envoi plus 5 760 o de fenetre par socket TCP : plus que tout
# le tas libre une fois le Wi-Fi, le web, deux connexions TLS et la radio en route (~40 Ko sur
# l'ATOM). Mesure du 2026-11-13 sur l'ATOM, broker local injoignable, cloud actif, journal web
# suivi toutes les 2 s, volet commande :
#   defaut : 1 937 refus de tampons Wi-Fi, 52 « Failed to initialize », web sourd 8 min ;
#   borne  : 0 refus, 0 « Failed to initialize », web 98 % des releves, 18 a 32 Ko libres.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# 2 segments de 1 440 o : le minimum qui garde un debit correct.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
