{
  "name": "openprofalux-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interface web du boitier OpenProfalux, en Vue 3 (issue #120). Construite par tools/build_ui.sh, embarquee par le firmware.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:mock": "npm run typecheck && vite build --mode mock"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
